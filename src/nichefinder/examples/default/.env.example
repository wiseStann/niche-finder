# niche-finder keys. Copy to <your-workspace>/.env and fill in what you have.
# Every key is optional: stages that need a missing key are skipped with a message.
# Environment variables take precedence over this file.

# DataForSEO — Google Ads search volume, CPC, 48-month history (S3). Paid, pay-as-you-go.
# https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# LLM for classifying Reddit posts (S10). Any OpenAI-compatible chat completions endpoint:
# DeepSeek, OpenAI, OpenRouter, a local server, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Optional JSON merged into every request body, e.g. {"thinking": {"type": "disabled"}}
LLM_EXTRA_BODY=

# Yandex Wordstat (Russian market module only). Yandex Cloud API key with Search API access.
# https://yandex.cloud/en/docs/search-api/
YANDEX_API_KEY=

# Proxies. HTTPS_PROXY applies to every request.
# NF_PROXY_RU applies only to Russian sources (hh.ru, zakupki, software registry), which may
# refuse connections from outside Russia.
HTTPS_PROXY=
NF_PROXY_RU=
